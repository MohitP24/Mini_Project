# ============================================================
# SENTINEL — ENVIRONMENT VARIABLES MASTER TEMPLATE
# Copy to .env and fill in values. NEVER commit .env
# ============================================================

# DATABASE
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel_app
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
EVENT_WRITER_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
SENTINEL_READER_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# JWT / RS256 KEYS
SENTINEL_JWT_PRIVATE_KEY_PATH=/run/secrets/sentinel_private_key.pem
SENTINEL_JWT_PUBLIC_KEY_PATH=/run/secrets/sentinel_public_key.pem
SENTINEL_JWT_PRIVATE_KEY_B64=REPLACE_WITH_BASE64_ENCODED_PRIVATE_PEM
SENTINEL_JWT_PUBLIC_KEY_B64=REPLACE_WITH_BASE64_ENCODED_PUBLIC_PEM
SENTINEL_JWT_ISSUER=sentinel-auth
SENTINEL_JWT_AUDIENCE=sentinel-api
SENTINEL_JWT_ALGORITHM=RS256

# GATEWAY
GATEWAY_PORT=8080
GATEWAY_VERSION=3.0.0
GATEWAY_PUBLIC_ENDPOINTS=/actuator/health,/actuator/info,/login

# SERVICE PORTS
FORENSICS_API_PORT=8082
ADMIN_API_PORT=8083
MOCK_PAYMENT_PORT=9001
MOCK_USER_PORT=9002
MOCK_ADMIN_PORT=9003

# SERVICE URLS
MOCK_PAYMENT_URL=http://mock-payment-service:9001
MOCK_USER_URL=http://mock-user-service:9002
MOCK_ADMIN_URL=http://mock-admin-service:9003
FORENSICS_API_URL=http://sentinel-forensics-api:8082
ADMIN_API_URL=http://sentinel-admin-api:8083
GATEWAY_INTERNAL_URL=http://sentinel-gateway:8080

# RISK SCORER WEIGHTS
RISK_WEIGHT_IP_REPUTATION=0.30
RISK_WEIGHT_REQUEST_RATE=0.25
RISK_WEIGHT_JWT_ANOMALY=0.25
RISK_WEIGHT_ENDPOINT_FREQ=0.20
RISK_FLAG_THRESHOLD=0.70
RISK_RATE_WINDOW_SECONDS=60
RISK_RATE_MAX_REQUESTS=100

# POLICY ENGINE
POLICY_CACHE_TTL_SECONDS=2
POLICY_DEFAULT_ACTION=DENY

# DATABASE POOL (HikariCP)
DB_POOL_MINIMUM_IDLE=5
DB_POOL_MAXIMUM_SIZE=20
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=600000

# FRONTEND
VITE_API_BASE_URL=http://localhost:8082
VITE_ADMIN_API_BASE_URL=http://localhost:8083
VITE_APP_TITLE=Sentinel Dashboard
DASHBOARD_PORT=3000

# OBSERVABILITY
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true

# DEMO FIXTURES
FIXTURE_SESSION_F01=00000000-0001-0001-0001-000000000001
FIXTURE_SESSION_F02=00000000-0002-0002-0002-000000000002
FIXTURE_SESSION_F03=00000000-0003-0003-0003-000000000003
